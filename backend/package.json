{
  "name": "blog-api",
  "version": "2.0.0",
  "description": "API de Blog Dinâmico - POSTECH Fase 04 (posts, professores, alunos e autenticação)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:memory": "node src/devServerMemoria.js",
    "seed": "node src/seeds/seed.js",
    "test": "cross-env NODE_ENV=test jest --coverage --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.1",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/seeds/**"
    ]
  },
  "mongodbMemoryServer": {
    "version": "6.0.4"
  }
}
